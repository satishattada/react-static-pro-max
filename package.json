{
  "name": "react-static-pro-max",
  "description": "A progressive static site generator for React",
  "version": "2.0.16",
  "license": "MIT",
  "repository": "https://github.com/satishattada/react-static-pro-max.git",
  "main": "lib/index.js",
  "author": "Satish Attada <satishattada@gmail.com>",
  "types": "src/index.d.ts",
  "keywords": [
    "react",
    "static",
    "generator",
    "ssr",
    "spa"
  ],
  "bugs": {
    "url": "https://github.com/satishattada/react-static-pro-max/issues"
  },
  "homepage": "https://github.com/satishattada/react-static-pro-max#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "react-static-pro-max": "./bin/react-static-pro-max"
  },
  "files": [
    "lib",
    "bin",
    "node",
    "templates",
    "babel-preset.js",
    "setupTests.js"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./node": "./node/index.js"
  },
  "scripts": {
    "prebuild": "rimraf lib",
    "build": "cross-env REACT_STATIC_INTERNAL=true babel src --out-dir lib --ignore \"**/__tests__/*\" --ignore \"**/__mocks__/*\" --source-maps inline",
    "watch": "npm run build -- --watch",
    "watch:link": "onchange './lib/**/*' -- yalc push --changed",
    "start": "npm run watch",
    "test": "npm run format && npm run unitTest",
    "lint": "eslint src --fix",
    "format": "prettier README.md {src,templates/*/src}/**/*.js --write",
    "unitTest": "cross-env NODE_ENV=test jest ./src",
    "unitTestWatch": "cross-env NODE_ENV=test jest src --watch",
    "preversion": "npm run build",
    "preversion:full": "npm run build && npm run test",
    "publishLink": "echo 'Publishing to yalc...' && yalc publish",
    "security-audit": "npm audit",
    "security-fix": "npm audit fix --force",
    "outdated": "npm outdated",
    "clean": "rimraf node_modules package-lock.json",
    "fresh-install": "npm run clean && npm install"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-export-default-from": "^7.27.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-destructuring": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.3",
    "@babel/runtime": "^7.28.4",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "ansi-escapes": "^7.2.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "buffer": "^6.0.3",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "circular-dependency-plugin": "^5.2.2",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "extract-css-chunks-webpack-plugin": "^4.10.0",
    "figures": "^6.1.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.3.2",
    "glob": "^13.0.0",
    "gunzip-maybe": "^1.4.2",
    "html-webpack-plugin": "^5.6.5",
    "inquirer": "^13.1.0",
    "intersection-observer": "^0.12.2",
    "jsesc": "^3.1.0",
    "match-sorter": "^8.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "minimist": "^1.2.8",
    "mutation-observer": "^1.0.3",
    "picocolors": "^1.1.1",
    "portfinder": "^1.0.38",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.2.0",
    "pretty-error": "^4.0.0",
    "process": "^0.11.10",
    "progress": "^2.0.3",
    "prop-types": "^15.8.1",
    "raf": "^3.4.1",
    "raw-loader": "^4.0.2",
    "react-helmet": "^6.1.0",
    "resolve-from": "^5.0.0",
    "run-async": "^4.0.6",
    "rxjs": "^7.8.2",
    "sass": "^1.97.0",
    "sass-loader": "^16.0.6",
    "serve": "^14.2.5",
    "shorthash": "^0.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "swimmer": "^1.4.0",
    "tar-fs": "^3.1.1",
    "terser-webpack-plugin": "^5.3.16",
    "upath": "^2.0.1",
    "url-loader": "^4.1.1",
    "util": "^0.12.5",
    "webpack": "^5.104.0",
    "webpack-bundle-analyzer": "^5.1.0",
    "webpack-dev-server": "^5.2.2",
    "webpack-flush-chunks": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.2.7",
    "@types/react-helmet": "^6.1.11",
    "babel-jest": "^30.2.0",
    "cheerio": "^1.1.2",
    "cross-env": "^10.1.0",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.3.0",
    "jsdom-global": "^3.0.2",
    "lerna": "^9.0.3",
    "onchange": "^7.1.0",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "rimraf": "^6.1.2",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "verbose": true,
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "testRegex": "(/__tests__/.*\\.(test))\\.jsx?$",
    "moduleNameMapper": {
      "static.config.js$": "<rootDir>/src/static/__mocks__/static.config.js.mock.js"
    },
    "setupFiles": [
      "<rootDir>/setupTests.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  }
}
