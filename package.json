{
  "name": "react-static-pro-max",
  "description": "A progressive static site generator for React",
  "version": "1.29.0",
  "license": "MIT",
  "repository": "https://github.com/satishattada/react-static-pro.git",
  "main": "lib/index.js",
  "author": "Satish Attada <satishattada@gmail.com>",
  "types": "src/index.d.ts",
  "engines": {
    "node": ">=8.9.0"
  },
  "bin": {
    "react-static-pro-max": "./bin/react-static-pro-max"
  },
  "scripts": {
    "prebuild": "rimraf lib",
    "build": "cross-env REACT_STATIC_INTERNAL=true babel src --out-dir lib --ignore \"**/__tests__/*\" --ignore \"**/__mocks__/*\"  --source-maps inline",
    "watch": "yarn build --watch",
    "watch:link": "onchange './lib/**/*' -- yalc push --changed",
    "start": "yarn watch",
    "test": "yarn format && yarn unitTest",
    "lint": "eslint src",
    "format": "prettier README.md {src,templates/*/src}/**/*.js --write",
    "unitTest": "cross-env NODE_ENV=test yarn jest ./src",
    "unitTestWatch": "cross-env NODE_ENV=test yarn jest src --watch",
    "preversion": "yarn build && yarn test",
    "publishLink": "echo '{{event}} to {{changed}}' && yalc publish"
  },
  "peerDependencies": {
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/plugin-proposal-class-properties": "^7.5.5",
    "@babel/plugin-proposal-export-default-from": "^7.24.7",
    "@babel/plugin-proposal-optional-chaining": "^7.2.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-destructuring": "^7.24.7",
    "@babel/plugin-transform-modules-commonjs": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-stage-0": "^7.8.3",
    "@babel/register": "^7.24.6",
    "@babel/runtime": "^7.24.7",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "ansi-escapes": "^7.0.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "circular-dependency-plugin": "^5.2.2",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "extract-css-chunks-webpack-plugin": "^4.10.0",
    "figures": "^6.1.0",
    "file-loader": "6.2.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "gunzip-maybe": "^1.4.2",
    "html-webpack-plugin": "^5.6.0",
    "inquirer": "^10.0.1",
    "intersection-observer": "^0.12.2",
    "jsesc": "^3.0.2",
    "match-sorter": "^6.3.4",
    "minimist": "^1.2.8",
    "mutation-observer": "^1.0.3",
    "picocolors": "^1.0.1",
    "portfinder": "^1.0.32",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.1.1",
    "pretty-error": "^4.0.0",
    "progress": "^2.0.3",
    "prop-types": "^15.8.1",
    "raf": "^3.4.1",
    "raw-loader": "^4.0.2",
    "react-helmet": "^6.1.0",
    "resolve-from": "^5.0.0",
    "run-async": "^3.0.0",
    "rxjs": "^7.8.1",
    "serve": "^14.2.3",
    "shorthash": "^0.0.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "style-loader": "4.0.0",
    "swimmer": "^1.4.0",
    "tar-fs": "^3.0.6",
    "terser-webpack-plugin": "^5.3.10",
    "upath": "^2.0.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.92.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-dev-server": "^5.0.4",
    "webpack-flush-chunks": "^2.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-helmet": "^6.1.11",
    "babel-jest": "^29.7.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-react": "^7.34.3",
    "express": "^4.19.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "23.0.0",
    "jsdom-global": "3.0.2",
    "lerna": "^8.1.6",
    "onchange": "^7.1.0",
    "prettier": "3.3.2",
    "react": "^18.3.1",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.0",
    "webpack-hot-middleware": "^2.26.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "verbose": true,
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "testRegex": "(/__tests__/.*\\.(test))\\.jsx?$",
    "moduleNameMapper": {
      "static.config.js$": "<rootDir>/src/static/__mocks__/static.config.js.mock.js"
    },
    "setupFiles": [
      "<rootDir>/setupTests.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  }
}
